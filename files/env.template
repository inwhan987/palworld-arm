# =====================================================================
#  팰월드 서버 설정
#  주석은 pal apply 가 "무엇이 바뀌었는지" 디스코드로 알릴 때
#  사람이 읽을 이름으로 그대로 쓰입니다. 지우지 마세요.
#  값을 바꾼 뒤에는 반드시  pal apply
# =====================================================================

# ---------------------------------------------------------------- 서버
# 서버 이름 — 목록에 표시됩니다
SERVER_NAME=__SERVER_NAME__
# 서버 설명
SERVER_DESCRIPTION=Palworld on ARM
# 접속 비밀번호 — 친구들에게 알려줄 값
SERVER_PASSWORD=__SERVER_PASSWORD__
# 관리자 비밀번호 — RCON·REST API 인증에 쓰입니다
ADMIN_PASSWORD=__ADMIN_PASSWORD__
# 최대 인원
MAX_PLAYERS=__MAX_PLAYERS__
# 게임 포트
PUBLIC_PORT=8211
# 커뮤니티 서버 목록 공개 여부
COMMUNITY_SERVER=false
# 언어
LANGUAGE=ko

# ------------------------------------------------------------ 원격 제어
# RCON 사용 — pal 명령이 게임에 말을 걸 때 씁니다
RCON_ENABLED=true
RCON_PORT=25575
# REST API 사용 — 접속자 수 확인·공지·저장에 씁니다
RESTAPI_ENABLED=true
RESTAPI_PORT=8212

# ---------------------------------------------------------------- 배율
# 경험치 배율
EXP_RATE=__EXP_RATE__
# 포획 확률 — 최대 2.0
PAL_CAPTURE_RATE=__CAPTURE_RATE__
# 팰 출현 수
PAL_SPAWN_NUM_RATE=1.0
# 채집 획득량
COLLECTION_DROP_RATE=1.0
# 채집물 내구도
COLLECTION_OBJECT_HP_RATE=1.0
# 채집물 재생성 속도
COLLECTION_OBJECT_RESPAWN_SPEED_RATE=1.0
# 적 드랍 아이템 양
ENEMY_DROP_ITEM_RATE=1.0
# 아이템 무게 — 낮출수록 많이 들 수 있음
ITEM_WEIGHT_RATE=1.0
# 낮 시간 속도
DAY_TIME_SPEED_RATE=1.0
# 밤 시간 속도 — 올리면 밤이 빨리 지나감
NIGHT_TIME_SPEED_RATE=1.0

# ------------------------------------------------------------ 플레이어
# 플레이어 공격력
PLAYER_DAMAGE_RATE_ATTACK=1.0
# 플레이어 받는 피해
PLAYER_DAMAGE_RATE_DEFENSE=1.0
# 플레이어 허기 감소 속도
PLAYER_STOMACH_DECREASE_RATE=1.0
# 플레이어 스태미나 감소 속도
PLAYER_STAMINA_DECREASE_RATE=1.0
# 플레이어 체력 회복 속도
PLAYER_AUTO_HP_REGEN_RATE=1.0
# 수면 중 체력 회복 속도
PLAYER_AUTO_HP_REGEN_RATE_IN_SLEEP=1.0

# ----------------------------------------------------------------- 팰
# 팰 공격력
PAL_DAMAGE_RATE_ATTACK=1.0
# 팰 받는 피해
PAL_DAMAGE_RATE_DEFENSE=1.0
# 팰 허기 감소 속도 — 낮출수록 덜 배고파합니다
PAL_STOMACH_DECREASE_RATE=0.5
# 팰 스태미나 감소 속도
PAL_STAMINA_DECREASE_RATE=1.0
# 팰 체력 회복 속도
PAL_AUTO_HP_REGEN_RATE=1.0
# 수면 중 팰 체력 회복 속도
PAL_AUTO_HP_REGEN_RATE_IN_SLEEP=1.0
# 알 부화 시간(시간) — 가장 큰 알 기준
PAL_EGG_DEFAULT_HATCHING_TIME=2.0

# ---------------------------------------------------------------- 거점
# 거점 건물 내구도
BUILD_OBJECT_HP_RATE=1.0
# 거점 건물 손상 속도
BUILD_OBJECT_DAMAGE_RATE=1.0
# 거점 건물 열화 속도
BUILD_OBJECT_DETERIORATION_DAMAGE_RATE=0.0
# 거점 팰 작업 속도
PAL_WORK_SPEED_RATE=1.5
# 길드당 거점 수
BASE_CAMP_MAX_NUM_IN_GUILD=4
# 거점 작업 팰 최대 수
BASE_CAMP_WORKER_MAX_NUM=15
# 길드 최대 인원
GUILD_PLAYER_MAX_NUM=20

# ---------------------------------------------------------------- 사망
# 사망 시 드랍 — 0:없음 1:장비만 2:전부 3:전부+팰
DEATH_PENALTY=0
# 사망 후 재입장 대기 시간(초)
ENABLE_INVADER_ENEMY=true

# ------------------------------------------------------------ 디스코드
# 디스코드 알림 사용
DISCORD_ENABLED=true
# 디스코드 웹후크 주소
DISCORD_WEBHOOK_URL=__DISCORD_WEBHOOK__
# 접속 알림 — 잦아서 기본 꺼짐
DISCORD_EVENT_JOIN=false
# 퇴장 알림 — 잦아서 기본 꺼짐
DISCORD_EVENT_LEAVE=false
# 서버 상태 변화 알림
DISCORD_EVENT_SERVER_STATUS=true
# 무인 상태 경고 — 사람 없을 때 5분마다 오던 경고, 기본 꺼짐 (패치로 추가된 항목)
IDLE_WARNING_ENABLED=false

# ------------------------------------------------------------ 자동 관리
# 기동 시 게임 업데이트 확인 — 켜면 재시작이 느려집니다
UPDATE_ON_START=false
# 강제 업데이트
FORCE_UPDATE=false
# SteamCMD 파일 검증 — 켜면 매우 느립니다
STEAMCMD_VALIDATE=false
# 새 버전 확인 로그
CHECK_VERSION_UPDATE=true
# 무인 시 자동 재시작 — 별도 크론으로 관리하므로 꺼둡니다
IDLE_RESTART_ENABLED=false
# 자동 백업 사용
BACKUP_ENABLED=true
# 백업 주기(분)
BACKUP_INTERVAL=60
# 백업 보관 일수
BACKUP_RETENTION_DAYS=7

# ---------------------------------------------------------------- 성능
# 서버 틱 레이트
ENGINE_SERVER_TICK_RATE=120
# 네트워크 틱 레이트
ENGINE_NET_SERVER_MAX_TICK_RATE=120
